# ==============================================================================
# Parallax - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` and fill in your team credentials:
#   cp .env.example .env
# ==============================================================================

# --- AWS Configuration ---
# All team compute and storage reside in us-east-1 for free high-speed data transfer
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default

# --- Parallax Storage & Paths ---
# Shared team S3 bucket hosted by Account #1
PARALLAX_S3_BUCKET=amazon-ml-2026-parallax-shared
PARALLAX_AWS_REGION=us-east-1
# Override local workspace root if running from outside project directory
# PARALLAX_ROOT=/path/to/Parallax

# --- Compute & Hardware ---
# Compute acceleration device: "cuda", "cpu", or "mps"
PARALLAX_DEVICE=cuda

# --- Model & Experiment Tracking (Optional) ---
# HF_TOKEN=your_huggingface_hub_token
# WANDB_API_KEY=your_wandb_api_key
# WANDB_PROJECT=amazon-ml-challenge-2026
